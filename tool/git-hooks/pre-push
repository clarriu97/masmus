#!/usr/bin/env bash
# Runs the PR checks before every push (~1 min). Enable once per clone:
#   git config core.hooksPath tool/git-hooks
# Include the release builds too:   ALL=1 git push
# Skip in an emergency:             git push --no-verify
set -euo pipefail
if [[ "${ALL:-}" == 1 ]]; then
  exec tool/ci.sh all
fi
exec tool/ci.sh
